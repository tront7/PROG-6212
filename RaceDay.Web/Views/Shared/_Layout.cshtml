@{
    var session = Context.Session;
    var isAuth = session.IsAuthenticated();
    var role = session.CurrentRole();
    var fullName = session.GetString(SessionKeys.FullName) ?? string.Empty;
    var picture = session.GetString(SessionKeys.ProfilePictureUrl);
    var initial = string.IsNullOrWhiteSpace(fullName) ? "?" : fullName.Trim()[0].ToString().ToUpperInvariant();

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Active(string c, params string[] actions) =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase) &&
        actions.Any(a => a.Equals(action, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNav" aria-controls="rdNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="rdNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (isAuth && role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Events", "CreateEvent", "EditEvent")" asp-controller="Organiser" asp-action="Events">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Categories")" asp-controller="Organiser" asp-action="Categories">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Enrolments")" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Results")" asp-controller="Organiser" asp-action="Results">Results</a></li>
                    }
                    else if (isAuth && role == "Participant")
                    {
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Index", "EventDetails")" asp-controller="Participant" asp-action="Index">Find events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    }
                </ul>

                @if (isAuth)
                {
                    <div class="dropdown">
                        <a class="rd-usermenu dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrWhiteSpace(picture))
                            {
                                <img src="@picture" class="rd-avatar" alt="" />
                            }
                            else
                            {
                                <span class="rd-avatar">@initial</span>
                            }
                            <span class="d-none d-lg-inline ms-2">@fullName</span>
                            <span class="rd-rolechip ms-2">@role</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Sign up</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] is string successMessage || ViewData["Success"] is string)
        {
            <div class="container pt-3">
                <div class="alert alert-success alert-dismissible fade show rd-alert" role="alert">
                    @(TempData["Success"] as string ?? ViewData["Success"] as string)
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string || ViewData["Error"] is string)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
                    @(TempData["Error"] as string ?? ViewData["Error"] as string)
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span class="rd-brand rd-brand-sm">RACE<span>DAY</span></span>
            <span>South Africa's home for road running, walking and cycling events.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
