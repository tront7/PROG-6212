@model EventDto
<div class="card rd-card rd-event-card h-100">
    <div class="position-relative">
        <partial name="_EventBanner" model="new BannerModel(Model.BannerImageUrl, Model.EventType)" />
        <div class="rd-card-badge"><partial name="_TypeBadge" model="Model.EventType" /></div>
    </div>
    <div class="card-body d-flex flex-column">
        <div class="rd-date-chip mb-2">@Formatters.ShortDate(Model.EventDate) · @Formatters.Time(Model.EventDate)</div>
        <h3 class="h4 mb-2">@Model.EventName</h3>
        <ul class="rd-meta list-unstyled mb-3">
            <li>📍 @Model.Location</li>
            <li>📏 @Formatters.Distance(Model.DistanceKm)</li>
        </ul>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted small flex-grow-1 mb-3">@(Model.Description.Length > 110 ? Model.Description[..110] + "…" : Model.Description)</p>
        }
        else
        {
            <div class="flex-grow-1"></div>
        }
        <a class="btn btn-primary w-100" asp-controller="Participant" asp-action="EventDetails" asp-route-id="@Model.EventId">View event</a>
    </div>
</div>
