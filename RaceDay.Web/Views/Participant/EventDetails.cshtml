@model EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.EventName;
    var ev = Model.Event;
    var banner = new BannerModel(ev.BannerImageUrl, ev.EventType, "rd-banner-lg");
}

<div class="rd-pagehead">
    <div class="container">
        <p class="mb-2"><a asp-action="Index">← All events</a></p>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <h1 class="mb-0">@ev.EventName</h1>
            <partial name="_TypeBadge" model="ev.EventType" />
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="mb-4">
                <partial name="_EventBanner" model="banner" />
            </div>

            <div class="card rd-card">
                <div class="card-body p-4">
                    <h2 class="h3 mb-3">About this event</h2>
                    @if (string.IsNullOrWhiteSpace(ev.Description))
                    {
                        <p class="text-muted mb-0">The organiser hasn't added a description yet.</p>
                    }
                    else
                    {
                        <p style="white-space: pre-line" class="mb-0">@ev.Description</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card rd-card mb-4">
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-0 rd-eventfacts">
                        <li class="mb-3"><div class="rd-date-chip">When</div><div class="fw-bold">@Formatters.LongDate(ev.EventDate)</div><div class="text-muted">Start @Formatters.Time(ev.EventDate)</div></li>
                        <li class="mb-3"><div class="rd-date-chip">Where</div><div class="fw-bold">📍 @ev.Location</div></li>
                        <li class="mb-3"><div class="rd-date-chip">Distance</div><div class="fw-bold">📏 @Formatters.Distance(ev.DistanceKm)</div></li>
                        <li><div class="rd-date-chip">Organiser</div><div class="fw-bold">@ev.OrganiserName</div></li>
                    </ul>
                </div>
            </div>

            <div class="card rd-card">
                <div class="card-body p-4">
                    <h2 class="h3 mb-3">Choose your category</h2>

                    @if (Model.IsPast)
                    {
                        <div class="alert alert-secondary rd-alert mb-0">This event has already taken place.</div>
                    }
                    else if (!Model.Categories.Any())
                    {
                        <p class="text-muted mb-0">The organiser hasn't opened any categories for entry yet. Check back soon.</p>
                    }
                    else
                    {
                        @foreach (var c in Model.Categories)
                        {
                            var mine = Model.EnrolmentFor(c.CategoryId);
                            <div class="d-flex justify-content-between align-items-center gap-3 py-3 border-bottom">
                                <div>
                                    <div class="fw-bold">@c.CategoryName</div>
                                    <div class="small text-muted">@Formatters.Distance(c.DistanceKm) · @Formatters.Rand(c.Price)</div>
                                    <div class="small @(c.IsFull ? "text-danger fw-semibold" : "text-muted")">
                                        @(c.IsFull ? "Sold out" : $"{c.SpotsLeft} spot{(c.SpotsLeft == 1 ? "" : "s")} left")
                                    </div>
                                </div>
                                <div class="text-end">
                                    @if (mine is not null)
                                    {
                                        <partial name="_StatusBadge" model="mine.Status" />
                                        <div class="small text-muted mt-1">You're entered</div>
                                    }
                                    else if (c.IsFull)
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>Full</button>
                                    }
                                    else
                                    {
                                        <form asp-action="Enrol" method="post" data-once>
                                            <input type="hidden" name="eventId" value="@ev.EventId" />
                                            <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                            <button type="submit" class="btn btn-primary">Enter event</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
