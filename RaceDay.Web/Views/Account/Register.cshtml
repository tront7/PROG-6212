@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
}

<div class="container">
    <div class="rd-auth-wrap" style="max-width: 560px;">
        <div class="card rd-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="mb-1">Join RaceDay</h1>
                <p class="text-muted mb-4">Create your account in under a minute.</p>

                <form asp-action="Register" method="post" data-once novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert py-2"></div>

                    <div class="mb-4">
                        <label class="form-label">I want to…</label>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" asp-for="Role" id="roleParticipant" value="Participant" checked="@(Model.Role == "Participant")" />
                                <label class="rd-rolepick" for="roleParticipant">
                                    <strong>🏃 Take part</strong><br />
                                    <span class="small text-muted">Find events, enter and track my results</span>
                                </label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" asp-for="Role" id="roleOrganiser" value="Organiser" checked="@(Model.Role == "Organiser")" />
                                <label class="rd-rolepick" for="roleOrganiser">
                                    <strong>📋 Organise events</strong><br />
                                    <span class="small text-muted">Create events and capture results</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Create account</button>
                </form>

                <p class="text-center text-muted mt-4 mb-0">
                    Already registered? <a asp-action="Login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>
