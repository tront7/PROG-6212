@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container">
    <div class="rd-empty">
        <div class="big">🚧</div>
        <h1 class="mb-2">@(ViewData["Code"] is int code && code > 0 ? code.ToString() : "Oops")</h1>
        <p class="lead">@ViewData["Message"]</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the start line</a>
    </div>
</div>
