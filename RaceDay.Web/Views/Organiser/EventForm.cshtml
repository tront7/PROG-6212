@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
    var action = Model.IsEdit ? "EditEvent" : "CreateEvent";
    var eventTypes = new[] { "Run", "Walk", "Cycle" };
    var hasBanner = !string.IsNullOrWhiteSpace(Model.ExistingBannerUrl);
}

<div class="rd-pagehead">
    <div class="container">
        <h1>@(Model.IsEdit ? "Edit event" : "Create a new event")</h1>
        <p><a asp-action="Events">← Back to my events</a></p>
    </div>
</div>

<div class="container py-4">
    <div class="card rd-card">
        <div class="card-body p-4 p-md-5">
            <form asp-action="@action" asp-route-id="@(Model.IsEdit ? Model.EventId : (int?)null)" method="post" enctype="multipart/form-data" data-once novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert py-2"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label"></label>
                            <input asp-for="EventName" class="form-control" maxlength="150" required />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="5" maxlength="1000"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EventDate" class="form-label"></label>
                                <input asp-for="EventDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="EventDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label"></label>
                                <input asp-for="Location" class="form-control" maxlength="150" required />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DistanceKm" class="form-label"></label>
                                <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" max="1000" required />
                                <span asp-validation-for="DistanceKm" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EventType" class="form-label"></label>
                                <select asp-for="EventType" class="form-select">
                                    @foreach (var type in eventTypes)
                                    {
                                        <option value="@type" selected="@(Model.EventType == type)">@Formatters.TypeIcon(type) @type</option>
                                    }
                                </select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <label asp-for="BannerFile" class="form-label"></label>
                        <div class="mb-2">
                            <img id="bannerPreview" src="@(hasBanner ? Model.ExistingBannerUrl : "")" class="rd-banner rd-banner-lg @(hasBanner ? "" : "d-none")" alt="Banner preview" />
                            @if (!hasBanner)
                            {
                                <div id="bannerEmpty" class="rd-banner rd-banner-lg rd-banner-placeholder banner-@Model.EventType.ToLowerInvariant()"><span>@Formatters.TypeIcon(Model.EventType)</span></div>
                            }
                        </div>
                        <input asp-for="BannerFile" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/gif" data-preview="#bannerPreview" />
                        <span asp-validation-for="BannerFile" class="text-danger"></span>
                        <div class="form-text">Shown on the event page. JPG, PNG, WEBP or GIF, up to 5 MB.@(Model.IsEdit ? " Leave empty to keep the current banner." : "")</div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg px-4">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                    <a class="btn btn-outline-secondary btn-lg" asp-action="Events">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var bannerInput = document.querySelector('input[type="file"][data-preview]');
        var bannerEmpty = document.getElementById('bannerEmpty');
        if (bannerInput && bannerEmpty) {
            bannerInput.addEventListener('change', function () {
                if (bannerInput.files && bannerInput.files[0]) bannerEmpty.classList.add('d-none');
            });
        }
    </script>
}
