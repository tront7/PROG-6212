# Copy this file to ".env" (which is git-ignored) and fill in the values.

# Password for the SQL Server "sa" account inside Docker.
# Must be at least 8 characters with upper, lower, a number and a symbol. Avoid ; and = characters.
SA_PASSWORD=RaceDay_Passw0rd!

# Azure Storage account connection string (Azure Portal > Storage account > Access keys).
# Needed for banner and profile picture uploads.
AZURE_STORAGE_CONNECTION_STRING=

# Blob container used for images (created automatically).
AZURE_STORAGE_CONTAINER=raceday-images
